# Copy to .env and fill only what you need. Never commit .env.
# See docs/build/GAPS.md GAP-BOOT-02 and docs/LLD.md rain locks.

# Optional IMD path — never required for demo
IMD_API_KEY=

# Open-Meteo (free non-commercial tier; attribute CC-BY 4.0 in UI)
OPEN_METEO_BASE=https://api.open-meteo.com
# Locked metro rain: lat=28.6139 lon=77.2090 past_hours=6 timezone=Asia/Kolkata
RAIN_POLL_MINUTES=15

# Live source reliability (see docs/research/live-sources-constant-retrieval.md)
# DP_LIVE_FETCH=1 enables background rain/evidence/geo pollers (never blocks startup)
# DP_SOURCE_POLLING=0|1 overrides poller enablement
DP_EVIDENCE_POLL_MINUTES=60
DP_FLOOD_CONTEXT_ENABLED=0
DP_FLOOD_POLL_MINUTES=30
DP_SOURCE_TIMEOUT_SECONDS=10
DP_SOURCE_MAX_BACKOFF_SECONDS=900
# DP_NWDP_CWC_RESOURCE=   # set only after validated Yamuna/Delhi resource URL
# GOOGLE_FLOOD_API_KEY=
# DP_GOOGLE_FLOOD_ENABLED=0


# Local API / UI (Phase 7)
# API_HOST=127.0.0.1
# API_PORT=8000
# VITE_API_URL=http://127.0.0.1:8000
# Footer honesty chip: ship | sam | omit → "AWS · local fixtures"
# VITE_AWS_MODE=ship

# Ship It deploy (after G-CLOCK + G-AWS). No secrets here — use aws login / roles.
# See docs/operations/AWS_OPERATOR.md
# AWS_PROFILE=disputepoint
# AWS_REGION=ap-south-1
