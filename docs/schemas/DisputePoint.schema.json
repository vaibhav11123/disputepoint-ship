{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disputepoint.local/schemas/DisputePoint.json",
  "title": "DisputePoint",
  "type": "object",
  "required": ["id", "name", "lat", "lon", "agencies_claimed", "evidence_ids", "ownership_confidence", "ownership_state", "priority_score", "status", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^dp-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": 28.4, "maximum": 28.9 },
    "lon": { "type": "number", "minimum": 76.8, "maximum": 77.5 },
    "geometry": {
      "type": "object",
      "description": "Optional GeoJSON Point or LineString segment",
      "properties": {
        "type": { "enum": ["Point", "LineString"] },
        "coordinates": true
      }
    },
    "agencies_claimed": {
      "type": "array",
      "items": { "type": "string", "enum": ["PWD", "MCD", "NDMC", "IFC", "DDA", "DJB", "RAILWAYS", "CPWD", "OTHER", "UNKNOWN"] }
    },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "ownership_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ownership_state": { "enum": ["ASSIGNED", "CONFLICT", "UNKNOWN"] },
    "responsible_agency": { "type": ["string", "null"] },
    "severity": { "type": "number", "minimum": 0, "maximum": 1 },
    "recurrence_class": { "type": "string" },
    "is_underpass": { "type": "boolean" },
    "is_arterial": { "type": "boolean" },
    "readiness": { "$ref": "#/$defs/ReadinessSignal" },
    "priority_score": { "type": "number" },
    "priority_rank": { "type": "integer" },
    "recommended_action": { "type": "string" },
    "sla_hours": { "type": ["number", "null"] },
    "status": { "enum": ["OPEN", "ACKED", "RESOLVED"] },
    "provenance": { "$ref": "#/$defs/Provenance" }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "required": ["source", "retrieved_at", "is_synthetic", "is_derived"],
      "properties": {
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "source_date": { "type": ["string", "null"] },
        "evidence_type": { "type": "string" },
        "confidence": { "type": "number" },
        "is_synthetic": { "type": "boolean" },
        "is_derived": { "type": "boolean" }
      }
    },
    "ReadinessSignal": {
      "type": "object",
      "required": ["state", "is_synthetic"],
      "properties": {
        "state": { "enum": ["OK", "GAP", "UNKNOWN"] },
        "notes": { "type": "string" },
        "is_synthetic": { "type": "boolean" }
      }
    }
  }
}
